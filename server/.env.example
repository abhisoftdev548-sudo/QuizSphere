NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/quizsphere
CLIENT_ORIGIN=http://localhost:5173
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
SIGNUP_BONUS_QCOINS=100
COOKIE_SECURE=false
# Optional SMTP; without it, reset URLs are returned only in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=QuizSphere <no-reply@example.com>
